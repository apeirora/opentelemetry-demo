#
# Minimal audit collector (otelauditcol) from sibling opentelemetry-collector-contrib.
# Build context must be the parent OTEL directory (../ from opentelemetry-demo).
#
#   docker build -f opentelemetry-demo/src/otel-collector/Dockerfile.audit -t otel-demo-otelauditcol:local ..

FROM golang:1.25-bookworm AS builder

WORKDIR /src
COPY . .

RUN go install go.opentelemetry.io/collector/cmd/builder@v0.151.0

RUN ./internal/buildscripts/ocb-add-replaces.sh otelauditcol && \
    builder --skip-compilation --config cmd/otelauditcol/builder-config-replaced.yaml && \
    cd cmd/otelauditcol && CGO_ENABLED=0 GOOS=linux go build -trimpath -o /otelauditcol .

FROM alpine:3.21@sha256:5b10f432ef3da1b8d4c7eb6c487f2f5a8f096bc91145e68878dd4a5019afde11 AS certs
RUN apk --update --no-cache add ca-certificates

FROM scratch

ARG USER_UID=10001
USER ${USER_UID}

COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=builder /otelauditcol /otelauditcol

EXPOSE 4319
ENTRYPOINT ["/otelauditcol"]
